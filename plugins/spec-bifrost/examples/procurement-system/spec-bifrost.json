{
  "schemaVersion": "1.0",
  "project": {
    "name": "采购申请管理系统",
    "description": "用于创建、审批和跟踪采购申请的内部 B 端系统",
    "actors": ["申请人", "审批人", "采购专员"]
  },
  "optionSets": [
    {
      "id": "purchaseType",
      "label": "采购类型",
      "options": [
        { "value": "office", "label": "办公用品" },
        { "value": "software", "label": "软件服务" },
        { "value": "fixed_asset", "label": "固定资产" }
      ]
    },
    {
      "id": "approvalStatus",
      "label": "审批状态",
      "options": [
        { "value": "draft", "label": "草稿" },
        { "value": "pending", "label": "审批中" },
        { "value": "approved", "label": "已通过" },
        { "value": "rejected", "label": "已驳回" }
      ]
    },
    {
      "id": "supplierLevel",
      "label": "供应商等级",
      "options": [
        { "value": "preferred", "label": "优选供应商" },
        { "value": "qualified", "label": "合格供应商" },
        { "value": "temporary", "label": "临时供应商" }
      ]
    }
  ],
  "pages": [
    {
      "id": "purchase-list",
      "title": "采购申请列表",
      "purpose": "查看、筛选采购申请，并进入详情或新建申请",
      "route": "/purchases",
      "type": "list",
      "nav": { "visible": true, "label": "采购申请", "group": "采购管理", "order": 10 },
      "notes": ["列表默认展示最近 90 天申请。"],
      "sections": [
        {
          "id": "filters",
          "title": "筛选条件",
          "notes": ["筛选条件用于帮助申请人和审批人快速定位申请。"],
          "components": [
            {
              "id": "purchaseFilters",
              "type": "filterBar",
              "fields": [
                { "id": "status", "label": "审批状态", "type": "select", "optionSetId": "approvalStatus", "notes": ["状态口径以审批流程当前节点为准。"] },
                { "id": "purchaseType", "label": "采购类型", "type": "select", "optionSetId": "purchaseType" }
              ]
            }
          ]
        },
        {
          "id": "table",
          "title": "申请列表",
          "components": [
            {
              "id": "listMetrics",
              "type": "metricList",
              "title": "待处理概览",
              "items": [
                { "label": "审批中", "value": "12", "description": "当前仍在审批链路中的采购申请", "trend": "较昨日 +3" },
                { "label": "大额申请", "value": "4", "description": "申请金额超过 50000 的重点关注项" },
                { "label": "待补附件", "value": "6", "description": "软件服务或固定资产采购缺少必要附件" }
              ],
              "notes": ["指标用于表达审批人和采购专员进入列表前需要快速掌握的业务状态。"]
            },
            {
              "id": "requestKanban",
              "type": "kanbanBoard",
              "title": "申请状态看板",
              "items": [
                { "title": "草稿", "children": [{ "title": "REQ-2026-001", "description": "行政部办公用品采购" }] },
                { "title": "审批中", "children": [{ "title": "REQ-2026-008", "description": "研发部开发工具授权" }] },
                { "title": "待采购", "children": [{ "title": "REQ-2026-012", "description": "固定资产采购已通过审批" }] },
                { "title": "已完成", "children": [{ "title": "REQ-2026-018", "description": "显示器采购已验收" }] }
              ],
              "notes": ["看板用于表达列表页需要按业务状态聚合申请卡片。"]
            },
            {
              "id": "budgetUsageChart",
              "type": "chart",
              "title": "本月预算占用",
              "items": [
                { "label": "办公用品", "value": 68 },
                { "label": "软件服务", "value": 42 },
                { "label": "固定资产", "value": 86 }
              ],
              "notes": ["图表只表达预算占用事实，不指定图表库。"]
            },
            {
              "id": "purchaseTable",
              "type": "table",
              "columns": [
                { "id": "requestNo", "label": "申请编号", "type": "text" },
                { "id": "title", "label": "申请标题", "type": "text" },
                { "id": "amount", "label": "申请金额", "type": "currency" },
                { "id": "approvalStatus", "label": "审批状态", "type": "status", "optionSetId": "approvalStatus" }
              ],
              "actions": [
                { "id": "create", "type": "navigate", "label": "新建申请", "targetPageId": "purchase-edit", "notes": ["申请人从这里发起新的采购申请。"] },
                { "id": "batchExport", "type": "showMessage", "label": "批量导出", "message": "已生成选中申请的导出任务", "notes": ["批量操作作用于勾选的申请，不是单行操作。"] },
                { "id": "view", "type": "navigate", "label": "查看详情", "targetPageId": "purchase-detail" }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "purchase-edit",
      "title": "新建采购申请",
      "purpose": "填写采购申请信息并提交审批",
      "route": "/purchases/new",
      "type": "form",
      "nav": { "visible": true, "label": "新建申请", "group": "采购管理", "order": 20 },
      "sections": [
        {
          "id": "baseInfo",
          "title": "基本信息",
          "components": [
            {
              "id": "createWizard",
              "type": "wizard",
              "title": "创建申请向导",
              "items": [
                { "title": "基础信息", "description": "填写标题、采购类型、申请部门和预算金额。" },
                { "title": "采购明细", "description": "补充物品、数量、单价、预算科目和供应商。" },
                { "title": "附件确认", "description": "上传报价单、预算说明或合同扫描件。" },
                { "title": "提交审批", "description": "根据金额进入普通审批或大额审批路径。" }
              ]
            },
            {
              "id": "purchaseForm",
              "type": "form",
              "fields": [
                { "id": "title", "label": "申请标题", "type": "text", "required": true },
                { "id": "purchaseType", "label": "采购类型", "type": "select", "optionSetId": "purchaseType", "required": true },
                { "id": "requester", "label": "申请人", "type": "user", "required": true, "defaultValue": "当前用户" },
                { "id": "requestDepartment", "label": "申请部门", "type": "department", "required": true },
                { "id": "amount", "label": "申请金额", "type": "currency", "required": true, "validationRules": ["金额必须大于 0"] },
                { "id": "lineItemCount", "label": "采购明细数量", "type": "number", "required": true, "validationRules": ["明细数量至少为 1"] },
                { "id": "expectedArrivalDate", "label": "期望到货日期", "type": "date", "validationRules": ["期望到货日期不能早于提交日期"] },
                { "id": "supplierLevel", "label": "供应商等级", "type": "select", "optionSetId": "supplierLevel", "enabledWhen": { "fieldId": "purchaseType", "operator": "notEmpty" }, "notes": ["先选择采购类型后再确认供应商等级。"] },
                {
                  "id": "attachment",
                  "label": "附件",
                  "type": "file",
                  "requiredWhen": {
                    "any": [
                      { "fieldId": "purchaseType", "operator": "equals", "value": "software" },
                      {
                        "all": [
                          { "fieldId": "purchaseType", "operator": "equals", "value": "fixed_asset" },
                          { "fieldId": "amount", "operator": "greaterThan", "value": 10000 }
                        ]
                      }
                    ]
                  },
                  "displayRules": ["软件服务采购需上传报价单；固定资产采购金额超过 10000 时需上传预算说明附件"]
                },
                { "id": "budgetNote", "label": "预算说明", "type": "textarea", "requiredWhen": { "fieldId": "amount", "operator": "greaterThan", "value": 50000 }, "notes": ["金额超过 50000 时，预算说明是审批关注点。"] },
                { "id": "assetUsage", "label": "资产用途", "type": "textarea", "visibleWhen": { "fieldId": "purchaseType", "operator": "equals", "value": "fixed_asset" } }
              ],
              "actions": [
                { "id": "saveDraft", "type": "showMessage", "label": "保存草稿", "message": "草稿已保存到本地原型状态", "notes": ["MVP 只表达交互反馈，不持久化真实数据。"] },
                { "id": "submitNormal", "type": "submitPrototype", "label": "提交普通审批", "targetPageId": "purchase-detail", "actionWhen": { "fieldId": "amount", "operator": "lessThanOrEqual", "value": 50000 }, "message": "已提交普通审批", "notes": ["提交后申请人不能修改明细，只能撤回后重新编辑。"] },
                { "id": "submitHighAmount", "type": "submitPrototype", "label": "提交大额审批", "targetPageId": "approval-workbench", "actionWhen": { "fieldId": "amount", "operator": "greaterThan", "value": 50000 }, "message": "已进入大额审批路径", "notes": ["超过 50000 的申请需要补充预算说明后进入大额审批。"] }
              ]
            },
            {
              "id": "lineItemEditor",
              "type": "editableTable",
              "title": "采购明细行",
              "columns": [
                { "id": "itemName", "label": "物品名称", "type": "text" },
                { "id": "quantity", "label": "数量", "type": "number" },
                { "id": "unitPrice", "label": "单价", "type": "currency" },
                { "id": "budgetSubject", "label": "预算科目", "type": "text" },
                { "id": "supplier", "label": "候选供应商", "type": "text" }
              ],
              "items": [
                { "itemName": "27 寸显示器", "quantity": 2, "unitPrice": "¥1,600.00", "budgetSubject": "办公设备", "supplier": "优选供应商 A" },
                { "itemName": "SaaS 授权", "quantity": 10, "unitPrice": "¥360.00", "budgetSubject": "软件服务", "supplier": "合格供应商 B" }
              ],
              "actions": [
                { "id": "addLineItem", "type": "showMessage", "label": "新增明细", "message": "已新增一条采购明细" }
              ],
              "notes": ["可编辑明细用于表达一张申请中存在多条采购项和行级校验。"]
            },
            {
              "id": "submitChecklist",
              "type": "checklist",
              "title": "提交前资料清单",
              "items": [
                { "title": "采购明细至少一行", "status": "必填" },
                { "title": "软件服务采购上传报价单", "status": "条件必填" },
                { "title": "大额采购填写预算说明", "status": "条件必填" }
              ]
            },
            {
              "id": "submitResult",
              "type": "resultPanel",
              "title": "提交结果反馈",
              "emptyState": { "title": "提交成功", "description": "采购申请已进入对应审批流程。" },
              "actions": [
                { "id": "backToList", "type": "navigate", "label": "返回申请列表", "targetPageId": "purchase-list" }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "purchase-detail",
      "title": "采购申请详情",
      "purpose": "查看申请信息、明细和审批进度",
      "route": "/purchases/detail",
      "type": "detail",
      "nav": { "visible": false, "label": "申请详情" },
      "sections": [
        {
          "id": "summary",
          "title": "申请摘要",
          "components": [
            {
              "id": "summaryList",
              "type": "descriptionList",
              "fields": [
                { "id": "requestNo", "label": "申请编号", "type": "text" },
                { "id": "status", "label": "审批状态", "type": "status", "optionSetId": "approvalStatus" }
              ]
            },
            {
              "id": "detailTabs",
              "type": "tabs",
              "title": "详情分组",
              "items": [
                { "label": "基础信息", "description": "展示申请标题、金额、采购类型、供应商等级和申请部门。" },
                { "label": "采购明细", "description": "展示多条采购物品、数量、单价和品类标签。" },
                { "label": "审批记录", "description": "展示审批节点、处理人、处理时间和处理意见。" },
                { "label": "附件", "description": "展示报价单、预算说明、合同或验收材料。" }
              ],
              "notes": ["详情页用分组表达不同角色关注的信息，不要求真实 tab 交互持久化。"]
            },
            {
              "id": "purchaseItems",
              "type": "table",
              "columns": [
                { "id": "itemName", "label": "物品名称", "type": "text" },
                { "id": "categoryTag", "label": "品类标签", "type": "tag" },
                { "id": "quantity", "label": "数量", "type": "number" },
                { "id": "unitPrice", "label": "单价", "type": "currency" }
              ],
              "notes": ["采购明细用于研发理解一条申请中可能包含多个采购项。"]
            },
            {
              "id": "attachmentDrawer",
              "type": "drawer",
              "title": "附件查看抽屉",
              "fields": [
                { "id": "contractAttachment", "label": "合同或报价单附件", "type": "file", "notes": ["附件抽屉用于表达查看和补充材料的需求，不上传真实文件。"] }
              ],
              "actions": [
                { "id": "closeAttachmentDrawer", "type": "closeDrawer", "label": "关闭抽屉" }
              ]
            },
            {
              "id": "approvalSteps",
              "type": "steps",
              "notes": ["审批步骤只表达业务状态，不模拟真实审批流。"],
              "items": [
                { "title": "申请人提交", "description": "申请人提交采购申请，系统记录提交时间。" },
                { "title": "直属审批", "description": "审批人确认采购必要性和预算合理性。" },
                { "title": "采购处理", "description": "采购专员确认供应商和采购执行信息。" }
              ],
              "emptyState": { "title": "暂无审批记录" }
            },
            {
              "id": "approvalTimeline",
              "type": "timeline",
              "title": "审批时间线",
              "items": [
                { "title": "提交申请", "time": "2026-06-01 09:00", "description": "申请人提交采购申请，系统记录提交时间。", "status": "已完成" },
                { "title": "部门负责人审批", "time": "2026-06-01 10:20", "description": "确认采购必要性和预算归属。", "status": "已完成" },
                { "title": "采购专员处理", "time": "2026-06-01 14:00", "description": "确认供应商、报价材料和采购执行口径。", "status": "待处理" }
              ],
              "notes": ["时间线用于表达业务过程中的处理顺序和时间口径。"]
            },
            {
              "id": "approvalWorkflow",
              "type": "workflowDiagram",
              "title": "审批工作流",
              "items": [
                { "id": "draft", "title": "草稿", "description": "申请人保存或补充信息。" },
                { "id": "submitted", "title": "已提交", "description": "申请进入审批队列。" },
                { "id": "departmentApproval", "title": "部门审批", "description": "部门负责人确认必要性。" },
                { "id": "financeApproval", "title": "财务审批", "description": "财务确认预算归属。" },
                { "id": "procurementExecution", "title": "采购执行", "description": "采购专员确认供应商和交付。" },
                { "id": "completed", "title": "完成", "description": "采购验收完成。" },
                { "id": "rejected", "title": "驳回", "description": "申请人需要修改后重新提交。" }
              ],
              "relations": [
                { "sourceId": "draft", "targetId": "submitted", "label": "提交" },
                { "sourceId": "submitted", "targetId": "departmentApproval", "label": "部门审批" },
                { "sourceId": "departmentApproval", "targetId": "financeApproval", "label": "大额审批" },
                { "sourceId": "financeApproval", "targetId": "procurementExecution", "label": "通过" },
                { "sourceId": "procurementExecution", "targetId": "completed", "label": "验收" },
                { "sourceId": "departmentApproval", "targetId": "rejected", "label": "驳回" }
              ],
              "notes": ["工作流表达业务节点和流转，不表示技术状态机。"]
            },
            {
              "id": "approvalComments",
              "type": "commentThread",
              "title": "审批意见",
              "items": [
                { "author": "部门负责人", "time": "2026-06-01 10:20", "content": "采购必要性已确认，预算归属行政部。" },
                { "author": "财务审批", "time": "2026-06-01 11:35", "content": "预算科目可用，大额申请需补充报价单。" }
              ]
            },
            {
              "id": "detailAttachments",
              "type": "attachmentList",
              "title": "附件列表",
              "items": [
                { "title": "供应商报价单.pdf", "status": "已上传", "description": "用于比价和审批确认。" },
                { "title": "合同扫描件.pdf", "status": "待补充", "description": "采购执行前必须补齐。" },
                { "title": "验收单.pdf", "status": "未生成", "description": "交付完成后由采购专员上传。" }
              ]
            },
            {
              "id": "detailAuditLog",
              "type": "auditLog",
              "title": "审计日志",
              "columns": [
                { "id": "time", "label": "时间", "type": "text" },
                { "id": "actor", "label": "操作人", "type": "user" },
                { "id": "event", "label": "事件", "type": "text" }
              ],
              "items": [
                { "time": "2026-06-01 09:00", "actor": "申请人", "event": "提交审批" },
                { "time": "2026-06-01 10:20", "actor": "部门负责人", "event": "审批通过" },
                { "time": "2026-06-01 11:35", "actor": "财务审批", "event": "要求补充报价单" }
              ],
              "notes": ["审计日志表达业务留痕口径，不定义日志表结构。"]
            },
            {
              "id": "detailCollapsePanels",
              "type": "collapsePanel",
              "title": "补充信息",
              "items": [
                { "title": "财务信息", "description": "预算科目、可用余额、付款方式和发票要求。" },
                { "title": "审批备注", "description": "审批人对采购必要性、供应商和交付风险的说明。" },
                { "title": "附件说明", "description": "报价单、合同、验收单的上传状态和补充要求。" }
              ]
            },
            {
              "id": "documentRelations",
              "type": "relationGraph",
              "title": "关联单据",
              "items": [
                { "id": "request", "title": "采购申请" },
                { "id": "budget", "title": "预算科目" },
                { "id": "supplier", "title": "供应商" },
                { "id": "contract", "title": "合同" },
                { "id": "acceptance", "title": "验收单" }
              ],
              "relations": [
                { "sourceId": "request", "targetId": "budget", "label": "占用" },
                { "sourceId": "request", "targetId": "supplier", "label": "选择" },
                { "sourceId": "supplier", "targetId": "contract", "label": "签署" },
                { "sourceId": "contract", "targetId": "acceptance", "label": "生成" }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "approval-workbench",
      "title": "审批处理",
      "purpose": "审批人查看待处理申请并填写审批意见",
      "route": "/approvals",
      "type": "approval",
      "nav": { "visible": true, "label": "审批处理", "group": "审批", "order": 30 },
      "sections": [
        {
          "id": "decision",
          "title": "审批意见",
          "components": [
            {
              "id": "approvalForm",
              "type": "form",
              "fields": [
                {
                  "id": "decision",
                  "label": "审批结论",
                  "type": "radio",
                  "options": [
                    { "value": "approved", "label": "通过" },
                    { "value": "rejected", "label": "驳回" }
                  ],
                  "required": true
                },
                { "id": "rejectReason", "label": "驳回原因", "type": "textarea", "requiredWhen": { "fieldId": "decision", "operator": "equals", "value": "rejected" } }
              ],
              "actions": [
                { "id": "confirmApproval", "type": "submitPrototype", "label": "提交审批结果" }
              ]
            },
            {
              "id": "rejectConfirmModal",
              "type": "modal",
              "title": "驳回确认弹窗",
              "fields": [
                { "id": "rejectConfirmReason", "label": "确认驳回原因", "type": "textarea", "required": true, "notes": ["审批人驳回时必须确认原因，便于申请人修改后重新提交。"] }
              ],
              "actions": [
                { "id": "cancelReject", "type": "closeModal", "label": "取消" },
